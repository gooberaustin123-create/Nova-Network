[
  "marioparty",
  "cheeserolling"
]

fetch('games.json')
  .then(response => response.json())
  .then(games => {
    const listContainer = document.getElementById("gameList");
    games.forEach(game => {
      const li = document.createElement("li");
      li.innerHTML = `<a href="${game}.html" target="game-frame">${game}</a>`;
      listContainer.appendChild(li);
    });
  });
<ul id="gameList" style="display: none;">
  <li><a href="c1marioparty.html" target="game-frame">Mario Party</a></li>
  <li><a href="cheeserolling.html" target="game-frame">Cheese Rolling</a></li>
  <iframe name="game-frame" width="800" height="600"></iframe>
</ul>


<button onclick="document.getElementById('gameList').style.display = 'block'"; >Games</button>


